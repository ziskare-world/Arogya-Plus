{
  "$schema": "ArogyaPlus High-Speed AI Memory Database",
  "version": "2.0.0",
  "last_updated": "2026-07-29T11:19:45.938Z",
  "project": {
    "name": "ArogyaPlus",
    "title": "Smart Health Management System",
    "description": "Enterprise full-stack clinical platform supporting patient scheduling, real-time emergency ambulance dispatch, doctor digital prescriptions, telemedicine video rooms, and super admin live telemetry.",
    "tech_stack": {
      "runtime": "Node.js (v18+)",
      "server": "Express.js (^4.19.2)",
      "database": "MongoDB with Mongoose (^8.9.5)",
      "websockets": "Socket.IO (^4.8.1)",
      "push_notifications": "Web-Push VAPID (^3.6.7)",
      "payments": "Razorpay SDK (^2.9.4) & QR Code (^1.5.4)",
      "security": "Helmet (^8.3.0), Express Rate Limit (^8.6.0), BcryptJS (^2.4.3)",
      "testing": "Jest (^29.7.0), Supertest (^7.0.0), Mongo Memory Server (^10.1.4)",
      "frontend": "Vanilla HTML5, Custom Clinical CSS System, ES6 JavaScript Modules"
    },
    "entrypoint": "index.js",
    "directories": {
      "config": "Database connection wrappers",
      "middleware": "JWT auth, rate limiting, error handling, request validation",
      "models": "Mongoose schemas (User, Patient, Doctor, Appointment, Emergency, Ambulance, Payment, etc.)",
      "routes": "Express API endpoints",
      "scripts": "Utility scripts (VAPID keys, setup)",
      "tests": "Jest integration & unit tests",
      "ui": "Clinical portal pages for patient, doctor, admin, & super-admin",
      "utils": "Emergency queueing, WebPush services, symptom checker"
    }
  },
  "architecture": {
    "models": [
      {
        "name": "User",
        "file": "models/User.js",
        "roles": [
          "patient",
          "doctor",
          "admin",
          "superadmin"
        ],
        "fields": [
          "name",
          "email",
          "password",
          "phone",
          "role",
          "department",
          "isAvailable",
          "fcmToken",
          "createdAt"
        ]
      },
      {
        "name": "Appointment",
        "file": "models/Appointment.js",
        "statuses": [
          "pending",
          "confirmed",
          "completed",
          "cancelled"
        ],
        "fields": [
          "patient",
          "doctor",
          "date",
          "timeSlot",
          "status",
          "symptoms",
          "prescription",
          "meetLink"
        ]
      },
      {
        "name": "Emergency",
        "file": "models/Emergency.js",
        "severities": [
          "low",
          "medium",
          "critical"
        ],
        "statuses": [
          "pending",
          "assigned",
          "resolved"
        ],
        "fields": [
          "patient",
          "location",
          "severity",
          "status",
          "assignedAmbulance",
          "createdAt"
        ]
      },
      {
        "name": "Ambulance",
        "file": "models/Ambulance.js",
        "statuses": [
          "available",
          "dispatched",
          "maintenance"
        ],
        "fields": [
          "vehicleNumber",
          "driverName",
          "driverPhone",
          "status",
          "currentLocation",
          "hospitalBranch"
        ]
      },
      {
        "name": "Prescription",
        "file": "models/Prescription.js",
        "fields": [
          "patient",
          "doctor",
          "medicines",
          "diagnosis",
          "notes",
          "attachments",
          "date"
        ]
      },
      {
        "name": "Payment",
        "file": "models/Payment.js",
        "statuses": [
          "created",
          "paid",
          "failed"
        ],
        "fields": [
          "user",
          "amount",
          "currency",
          "razorpayOrderId",
          "razorpayPaymentId",
          "status",
          "purpose"
        ]
      },
      {
        "name": "PushSubscription",
        "file": "models/PushSubscription.js",
        "fields": [
          "user",
          "endpoint",
          "keys",
          "createdAt"
        ]
      }
    ],
    "routes": [
      {
        "path": "/api/auth",
        "file": "routes/authRoutes.js",
        "desc": "Login, register, token refresh, profile"
      },
      {
        "path": "/api/users",
        "file": "routes/userRoutes.js",
        "desc": "Patient portal metrics & EHR"
      },
      {
        "path": "/api/doctors",
        "file": "routes/doctorRoutes.js",
        "desc": "Doctor queues & digital prescriptions"
      },
      {
        "path": "/api/appointments",
        "file": "routes/appointmentRoutes.js",
        "desc": "Booking, rescheduling, cancellation"
      },
      {
        "path": "/api/ambulances",
        "file": "routes/ambulanceRoutes.js",
        "desc": "Dispatch requests & driver GPS tracking"
      },
      {
        "path": "/api/emergency",
        "file": "routes/emergencyRoutes.js",
        "desc": "Urgent SOS creation & queue processing"
      },
      {
        "path": "/api/admin",
        "file": "routes/adminRoutes.js",
        "desc": "Super admin system monitoring & broadcast alerts"
      },
      {
        "path": "/api/payments",
        "file": "routes/paymentRoutes.js",
        "desc": "Razorpay order creation & webhook verification"
      },
      {
        "path": "/api/notifications",
        "file": "routes/notificationRoutes.js",
        "desc": "VAPID key retrieval & web push setup"
      },
      {
        "path": "/api/ai",
        "file": "routes/aiRoutes.js",
        "desc": "Symptom checker & automated clinical triage"
      }
    ],
    "websocket_channels": [
      {
        "room": "room:admin",
        "desc": "Super admin live telemetry & system alerts"
      },
      {
        "room": "room:doctor:<doctorId>",
        "desc": "Doctor live appointment queue notifications"
      },
      {
        "room": "room:patient:<patientId>",
        "desc": "Patient updates & prescription alerts"
      },
      {
        "room": "room:emergency",
        "desc": "Ambulance driver & SOS operator emergency room"
      },
      {
        "room": "room:telemedicine:<appointmentId>",
        "desc": "WebRTC peer signaling for video calls"
      }
    ]
  },
